<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="84dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="4dp"
    android:background="#D9444444">

    <Button
        android:id="@+id/controllerPlay"
        android:layout_width="70dp"
        android:layout_height="54dp"
        android:text="▶"
        android:textSize="26sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2563EB"
        android:contentDescription="Start automatic change" />

    <TextView
        android:id="@+id/controllerStatus"
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:text="Ready"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:gravity="center"
        android:maxLines="3"
        android:padding="3dp" />

    <Button
        android:id="@+id/controllerStop"
        android:layout_width="70dp"
        android:layout_height="48dp"
        android:text="■"
        android:textSize="22sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#B23A2E"
        android:contentDescription="Stop automatic change" />

    <Button
        android:id="@+id/controllerRestore"
        android:layout_width="70dp"
        android:layout_height="54dp"
        android:text="+"
        android:textSize="30sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#3EAD4A"
        android:contentDescription="Restore all targets" />

    <Button
        android:id="@+id/controllerLock"
        android:layout_width="70dp"
        android:layout_height="48dp"
        android:text="🔓"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#59636E"
        android:contentDescription="Lock or unlock targets" />

    <Button
        android:id="@+id/controllerHide"
        android:layout_width="70dp"
        android:layout_height="42dp"
        android:text="Hide"
        android:textSize="11sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#444444"
        android:contentDescription="Hide floating controller" />

</LinearLayout>
