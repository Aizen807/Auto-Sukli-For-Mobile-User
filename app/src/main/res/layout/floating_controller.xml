<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="72dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="4dp"
    android:background="#D9444444">

    <Button
        android:id="@+id/controllerPlay"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:text="▶"
        android:textSize="28sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2563EB"
        android:contentDescription="Start automatic change" />

    <Button
        android:id="@+id/controllerRestore"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:text="+"
        android:textSize="34sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#3EAD4A"
        android:contentDescription="Restore all targets" />

</LinearLayout>
