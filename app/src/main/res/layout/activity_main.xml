<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10160D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fare Matrix Auto Sukli"
            android:textColor="#F3B22C"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Piliin ang route, pickup, drop-off, pasahero, at bayad. Awtomatikong kakalkulahin ang fare at sukli."
            android:textColor="#C9BE9E"
            android:textSize="14sp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F1E9D2"
            android:textSize="14sp"
            android:padding="12dp"
            android:background="#1A2415"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Enable Accessibility Service"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Show / Arrange Targets"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TRIP DETAILS"
            android:textColor="#F3B22C"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Route"
            android:textColor="#F1E9D2" />

        <Spinner
            android:id="@+id/spRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F1E9D2"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pickup / Sakayan"
            android:textColor="#F1E9D2" />

        <Spinner
            android:id="@+id/spPickup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F1E9D2"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Drop-off / Babaan"
            android:textColor="#F1E9D2" />

        <Spinner
            android:id="@+id/spDropoff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F1E9D2"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Passenger counts"
            android:textColor="#F1E9D2" />

        <EditText
            android:id="@+id/etRegularCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Regular passengers"
            android:inputType="number"
            android:textColor="#10160D"
            android:textColorHint="#666666"
            android:background="#F1E9D2"
            android:padding="12dp"
            android:text="1" />

        <EditText
            android:id="@+id/etStudentCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Student passengers"
            android:inputType="number"
            android:textColor="#10160D"
            android:textColorHint="#666666"
            android:background="#F1E9D2"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etSeniorCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Senior passengers"
            android:inputType="number"
            android:textColor="#10160D"
            android:textColorHint="#666666"
            android:background="#F1E9D2"
            android:padding="12dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Payment amount / Binayad"
            android:textColor="#F1E9D2" />

        <EditText
            android:id="@+id/etPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Halimbawa: 50"
            android:inputType="numberDecimal"
            android:textColor="#10160D"
            android:textColorHint="#666666"
            android:background="#F1E9D2"
            android:padding="12dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/tvFareResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fare: ₱0"
            android:textColor="#F3B22C"
            android:textSize="22sp"
            android:textStyle="bold"
            android:background="#1A2415"
            android:padding="14dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvBreakdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pumili ng trip details."
            android:textColor="#F1E9D2"
            android:textSize="14sp"
            android:padding="10dp"
            android:background="#212D1A"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvChangeResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sukli: ₱0"
            android:textColor="#6FA05B"
            android:textSize="22sp"
            android:textStyle="bold"
            android:background="#1A2415"
            android:padding="14dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvAutoSequence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-click order: —"
            android:textColor="#F1E9D2"
            android:textSize="15sp"
            android:background="#212D1A"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnCalculateAndGive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CALCULATE FARE + SAVE SUKLI"
            android:backgroundTint="#F3B22C"
            android:textColor="#1A2415"
            android:textStyle="bold"
            android:padding="16dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset trip"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fare rules: minimum 4 units • Regular ₱13 • Student/Senior ₱11 • +₱2 bawat unit lampas sa minimum"
            android:textColor="#C9BE9E"
            android:textSize="12sp"
            android:paddingTop="8dp" />

    </LinearLayout>
</ScrollView>
